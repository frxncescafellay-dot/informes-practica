import os
import glob
import pandas as pd
import streamlit as st
from google import genai

# --- CONFIGURACIÓN DEL SISTEMA ---
st.set_page_config(page_title="Plataforma Colaborativa de Informes IA", layout="wide")

CARPETA_COMPARTIDA = "archivos_compartidos"
os.makedirs(CARPETA_COMPARTIDA, exist_ok=True)

# Configura tu clave de Gemini aquí
API_KEY_GEMINI = os.environ.get("GEMINI_API_KEY", "")

# --- DEFINICIÓN DE PERFILES Y USUARIOS ---
USUARIOS = {
    "admin1": {"nombre": "Francesca Fellay", "rol": "Practicante", "pin": "1234"},
    "admin2": {"nombre": "Karol Medina", "rol": "Practicante", "pin": "5678"},
    "admin3": {"nombre": "Lukas Núñez", "rol": "Practicante", "pin": "9999"},
    "admin4": {"nombre": "Francisca Guerra", "rol": "Practicante", "pin": "0000"}
}

# --- CONTROL DE SESIÓN INDIVIDUAL ---
if "autenticado" not in st.session_state:
    st.session_state.autenticado = False
    st.session_state.usuario_actual = None

# Pantalla de Login
if not st.session_state.autenticado:
    st.title("🔐 Acceso a la Plataforma Multiusuario")
    col1, col2 = st.columns([1, 2])
    with col1:
        usuario_input = st.text_input("Usuario")
        pin_input = st.text_input("PIN / Contraseña", type="password")
        if st.button("Iniciar sesión", type="primary"):
            if usuario_input in USUARIOS and USUARIOS[usuario_input]["pin"] == pin_input:
                st.session_state.autenticado = True
                st.session_state.usuario_actual = USUARIOS[usuario_input]
                st.rerun()
            else:
                st.error("Credenciales incorrectas")
    st.stop()

# --- PANEL PRINCIPAL ---
usuario = st.session_state.usuario_actual

st.sidebar.markdown(f"**Usuario:** {usuario['nombre']}")
st.sidebar.markdown(f"**Rol:** `{usuario['rol']}`")

if st.sidebar.button("Cerrar Sesión"):
    st.session_state.autenticado = False
    st.session_state.usuario_actual = None
    st.rerun()

st.title("📊 Sistema Colaborativo de Análisis e Informes con IA")

# --- SECCIÓN 1: SUBIDA AL REPOSITORIO COMPARTIDO ---
st.subheader("📤 Subir nuevo archivo al repositorio común")
archivo_subido = st.file_uploader("Selecciona un archivo Excel (.xlsx, .xls) para compartir con el equipo:", type=["xlsx", "xls"])

if archivo_subido is not None:
    ruta_destino = os.path.join(CARPETA_COMPARTIDA, archivo_subido.name)
    if not os.path.exists(ruta_destino):
        with open(ruta_destino, "wb") as f:
            f.write(archivo_subido.getbuffer())
        st.success(f"Archivo '{archivo_subido.name}' subido correctamente por {usuario['nombre']}.")
        st.rerun()

st.markdown("---")

# --- SECCIÓN 2: BANDEJA DE ARCHIVOS COMPARTIDOS ---
st.subheader("📂 Repositorio de datos compartidos")

archivos_disponibles = glob.glob(os.path.join(CARPETA_COMPARTIDA, "*.xlsx")) + glob.glob(os.path.join(CARPETA_COMPARTIDA, "*.xls"))

if not archivos_disponibles:
    st.info("Aún no hay archivos en el repositorio. Sube un archivo arriba para comenzar.")
    st.stop()

nombres_archivos = [os.path.basename(ruta) for ruta in archivos_disponibles]
archivo_seleccionado_nombre = st.selectbox("Selecciona el dataset que deseas consultar o analizar:", nombres_archivos)

ruta_archivo_activo = os.path.join(CARPETA_COMPARTIDA, archivo_seleccionado_nombre)
df = pd.read_excel(ruta_archivo_activo)

# Vista previa de datos
st.markdown(f"**Vista previa:** `{archivo_seleccionado_nombre}` ({len(df)} registros)")
st.dataframe(df.head(10), use_container_width=True)

resumen_estadistico = df.describe(include="all").to_string()

st.markdown("---")

# --- SECCIÓN 3: CONFIGURACIÓN Y GENERACIÓN DE INFORME CON IA ---
st.subheader("🤖 Generación de Informe con IA")

col_tipo, col_extra = st.columns([1, 2])

with col_tipo:
    tipo_informe = st.selectbox(
        "Tipo de enfoque:",
        ["Resumen Ejecutivo", "Análisis de Anomalías y Riesgos", "Estrategia y Oportunidades de Mejora", "Técnico / Detallado"]
    )

with col_extra:
    instrucciones_extra = st.text_area(
        "Instrucciones o enfoque específico (opcional):",
        placeholder="Ej: Detectar las variables con mayor dispersión o enfocar en prioridades de atención..."
    )

if st.button("🚀 Generar Informe con IA", type="primary"):
    with st.spinner("Analizando datos compartidos y redactando informe..."):
        try:
            client = genai.Client(api_key=API_KEY_GEMINI)
            
            # Muestra de datos para el prompt (primeras 15 filas como texto)
            primeras_filas = df.head(15).to_string()
            
            prompt = f"""
            Actúa como un consultor y analista de datos senior.
            Genera un informe analítico estructurado y profesional con enfoque '{tipo_informe}'.
            
            Contexto del usuario solicitante:
            - Nombre: {usuario['nombre']}
            - Perfil/Rol: {usuario['rol']}
            - Archivo analizado: {archivo_seleccionado_nombre}
            
            Instrucciones adicionales:
            {instrucciones_extra}
            
            Resumen estadístico de las columnas:
            {resumen_estadistico}
            
            Muestra de datos (primeras filas):
            {primeras_filas}
            
            Estructura requerida para el reporte:
            1. Diagnóstico y Visión General del Dataset
            2. Hallazgos Críticos y Métricas Clave
            3. Conclusiones y Plan de Acción Recomendado
            """
            
            response = client.models.generate_content(
                model="gemini-3.6-flash",
                contents=prompt,
            )
            
            st.session_state["informe_generado"] = response.text
            
        except Exception as e:
            st.error(f"Error al conectar con la API de IA: {e}")

# Despliegue del informe
if "informe_generado" in st.session_state and st.session_state["informe_generado"]:
    st.markdown("---")
    st.subheader(f"📄 Informe Generado ({tipo_informe})")
    st.markdown(st.session_state["informe_generado"])
    
    st.download_button(
        label="📥 Descargar Informe (.md)",
        data=st.session_state["informe_generado"],
        file_name=f"informe_{archivo_seleccionado_nombre}.md",
        mime="text/markdown"
    )
